{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nvidia-powered-rag-production.up.railway.app/api/:1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
