# ==============================================================================
# 🔐 LORIN AI — ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values.
# NEVER commit .env to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🧠 LLM GATEWAYS & AI MODEL APIS
# ------------------------------------------------------------------------------
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
AI_GATEWAY_API_KEY_BACKUP=your_backup_key_here
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

PRIMARY_LLM_MODEL=zai/glm-5.3-flash
SECONDARY_LLM_MODEL=minimax/minimax-m3
FALLBACK_LLM_MODEL=google/gemini-2.5-flash-lite

WEBSEARCH_TOOL=parallel/search
WEBSEARCH_MODE=ON_DEMAND_ONLY
WEBSEARCH_FALLBACK_MODEL=google/gemini-2.5-flash-lite

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_MODEL=minimaxai/minimax-m3
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

OPENROUTER_API_KEY=your_openrouter_key_here

# ------------------------------------------------------------------------------
# 🗄️ DATABASE (Neon PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 🔍 VECTOR DATABASE (Qdrant Cloud)
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=nvidia_powered_ai

# ------------------------------------------------------------------------------
# 🔐 ADMIN PANEL
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_JWT_SECRET=your_random_jwt_secret_here

# ------------------------------------------------------------------------------
# 🌍 CORS — Allowed Frontend Origins (comma-separated)
# Set this to your Vercel frontend URL in production!
# Example: https://lorin-ai.vercel.app,https://yourdomain.com
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 🎙️ FRONTEND — Vite Environment Variables
# Set VITE_API_URL in Vercel dashboard to your Railway backend URL
# Example: https://lorin-ai-backend.railway.app
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
