# ==============================================================================
# 📋 LORIN AI — LOCAL DEVELOPMENT SAMPLE (.env.local)
# Copy this to backend/.env and frontend/.env and fill in YOUR values.
# This file is safe to commit — it contains NO real secrets.
# ==============================================================================

# ─────────────────────────────────────────────
# BACKEND variables → copy to backend/.env
# ─────────────────────────────────────────────

# LLM AI Gateway (get from vercel.com/dashboard → AI Gateway)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
AI_GATEWAY_API_KEY_BACKUP=your_backup_ai_gateway_key
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Model selection (leave defaults unless you want to change)
PRIMARY_LLM_MODEL=zai/glm-5.3-flash
SECONDARY_LLM_MODEL=minimax/minimax-m3
FALLBACK_LLM_MODEL=google/gemini-2.5-flash-lite
WEBSEARCH_TOOL=parallel/search
WEBSEARCH_MODE=ON_DEMAND_ONLY
WEBSEARCH_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# NVIDIA NIM (get from build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_CHAT_MODEL=minimaxai/minimax-m3
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# OpenRouter (get from openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant Cloud (get from cloud.qdrant.io)
QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=nvidia_powered_ai

# Neon PostgreSQL (get from console.neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NEON_PROJECT_ID=your_neon_project_id
NEON_BRANCH=production

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
JWT_SECRET=change_me_to_a_random_64char_secret

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# FRONTEND variables → copy to frontend/.env
# ─────────────────────────────────────────────

# Backend URL (local dev = localhost, prod = Railway URL)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Lorin AI
VITE_APP_VERSION=2.0.0
VITE_COLLEGE_NAME=Mohamed Sathak A.J. College of Engineering and Architecture
